def sample_population_risk(event_rate, n_trial, rng):
    """
    Sample one population-level risk from a Beta posterior.
    """
    if not (0.0 < event_rate < 1.0):
        raise ValueError("event_rate must be between 0 and 1.")

    k = int(round(event_rate * n_trial))

    alpha = 1.0 + k
    beta = 1.0 + n_trial - k

    return float(rng.beta(alpha, beta))


def calibrated_logit_intercept(target_mean, between_sd, rng, n_calibration=200_000):
    """
    Find a logit intercept such that E[logistic(intercept + Z)] = target_mean,
    with Z ~ N(0, between_sd^2).

    This ensures that between-patient heterogeneity does not shift the
    population mean away from the sampled population-level risk.
    """
    if not (0.0 < target_mean < 1.0):
        raise ValueError("target_mean must be between 0 and 1.")
    if between_sd < 0:
        raise ValueError("between_sd must be >= 0.")

    target_logit = np.log(target_mean / (1.0 - target_mean))

    if between_sd == 0:
        return target_logit

    z = rng.normal(0.0, between_sd, n_calibration)

    low = target_logit - 5.0
    high = target_logit + 5.0

    for _ in range(80):
        mid = 0.5 * (low + high)
        p = 1.0 / (1.0 + np.exp(-(mid + z)))

        if np.mean(p) < target_mean:
            low = mid
        else:
            high = mid

    return 0.5 * (low + high)


def sample_individual_risks(event_rate, n_trial, between_sd, n_profiles, rng):
    """
    Generate individual risks with:
      - one population-level risk draw
      - calibrated logit-normal between-patient heterogeneity
    """
    population_risk = sample_population_risk(event_rate, n_trial, rng)

    intercept = calibrated_logit_intercept(population_risk, between_sd, rng)

    z = rng.normal(0.0, between_sd, n_profiles)

    risks = 1.0 / (1.0 + np.exp(-(intercept + z)))

    return risks, population_risk


def generate_synthetic_profiles(population_name, n_profiles, between_sd, rng):
    """
    Generate synthetic patient profiles for a given trial population.
    """
    if population_name == "LENS":
        event_rate = LENS["event_rate_placebo"]
        n_trial = LENS["n_placebo"]
        label = "LENS-like"
    elif population_name == "ACCORD":
        event_rate = ACCORD["event_rate_placebo"]
        n_trial = ACCORD["n_placebo"]
        label = "ACCORD-like"
    else:
        raise ValueError("population_name must be 'LENS' or 'ACCORD'.")

    risk, population_risk = sample_individual_risks(
        event_rate,
        n_trial,
        between_sd,
        n_profiles,
        rng,
    )

    egfr = rng.normal(70.0, 15.0, n_profiles)
    egfr = np.clip(egfr, 25.0, 120.0)

    pill_count = rng.poisson(5.0, n_profiles) + 1
    pill_count = np.clip(pill_count, 2, 12)

    return risk, egfr, pill_count, label, population_risk


