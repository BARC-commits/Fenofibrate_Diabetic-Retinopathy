def calculate_net_utility(baseline_risk, rrr, egfr, pill_count, utility_weights=None):
    """
    Calculate the net utility of prescribing fenofibrate.
    
    Parameters:
    - baseline_risk: 4-year progression risk without treatment (0-1)
    - rrr: relative risk reduction (0-1)
    - egfr: estimated glomerular filtration rate (mL/min/1.73m²)
    - pill_count: total number of daily pills (including fenofibrate)
    - utility_weights: dict of utility weights (optional)
    
    Returns:
    - delta_u: net utility (prescribe vs. withhold)
    """
    if utility_weights is None:
        utility_weights = {
            'avoided_progression': 0.15,
            'avoided_treatment': 0.10,
            'egfr_penalty': 0.05,
            'egfr_dose_reduction': 0.08,
            'pill_burden': 0.02
        }
    
    arr = baseline_risk * rrr
    benefit = arr * (utility_weights['avoided_progression'] + utility_weights['avoided_treatment'])
    
    if egfr < 60:
        egfr_penalty = utility_weights['egfr_penalty'] * (1 + (60 - egfr) / 30)
    else:
        egfr_penalty = 0
    
    pill_penalty = utility_weights['pill_burden']
    delta_u = benefit - egfr_penalty - pill_penalty
    
    return delta_u

