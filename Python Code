def sample_baseline_risk_from_trial(trial_data, n_samples=10000):
    """
    Sample baseline risk distribution from trial summary data.
    """
    mean_risk = trial_data['event_rate_placebo']
    logit_mean = np.log(mean_risk / (1 - mean_risk))
    logit_sd = 0.5
    
    logit_samples = np.random.normal(logit_mean, logit_sd, n_samples)
    risk_samples = 1 / (1 + np.exp(-logit_samples))
    
    return risk_samples

def compute_decision_concordance(model1_params, model2_params, n_profiles=5000, 
                                 utility_weights=None, seed=42):
    """
    Compute the Utility Decision Concordance Index (UDCI) between two models.
    """
    np.random.seed(seed)
    
    risk1_samples = sample_baseline_risk_from_trial(LENS, n_profiles // 2)
    risk2_samples = sample_baseline_risk_from_trial(ACCORD, n_profiles // 2)
    risk_samples = np.concatenate([risk1_samples, risk2_samples])
    np.random.shuffle(risk_samples)
    
    egfr_samples = np.random.normal(70, 15, n_profiles)
    egfr_samples = np.clip(egfr_samples, 25, 120)
    
    pill_samples = np.random.poisson(5, n_profiles) + 1
    pill_samples = np.clip(pill_samples, 2, 12)
    
    decisions1 = []
    decisions2 = []
    utility_diffs1 = []
    utility_diffs2 = []
    
    for i in range(n_profiles):
        delta_u1 = calculate_net_utility(
            risk_samples[i],
            model1_params['rrr'],
            egfr_samples[i],
            pill_samples[i],
            utility_weights
        )
        decision1 = 1 if delta_u1 > 0 else 0
        decisions1.append(decision1)
        utility_diffs1.append(delta_u1)
        
        delta_u2 = calculate_net_utility(
            risk_samples[i],
            model2_params['rrr'],
            egfr_samples[i],
            pill_samples[i],
            utility_weights
        )
        decision2 = 1 if delta_u2 > 0 else 0
        decisions2.append(decision2)
        utility_diffs2.append(delta_u2)
    
    decisions1 = np.array(decisions1)
    decisions2 = np.array(decisions2)
    utility_diffs1 = np.array(utility_diffs1)
    utility_diffs2 = np.array(utility_diffs2)
    
    concordance = np.mean(decisions1 == decisions2)
    
    return {
        'concordance_rate': concordance,
        'decisions1': decisions1,
        'decisions2': decisions2,
        'utility_diffs1': utility_diffs1,
        'utility_diffs2': utility_diffs2,
        'risk_samples': risk_samples,
        'egfr_samples': egfr_samples,
        'pill_samples': pill_samples
    }

