def sample_log_rr_distribution(estimate, lower, upper, n_samples, rng):
    """
    Construct an approximate log-normal uncertainty distribution from a
    point estimate and 95% confidence interval.
    """
    if not (estimate > 0 and lower > 0 and upper > 0):
        raise ValueError("Estimate and CI limits must be > 0.")
    if not (lower <= estimate <= upper):
        raise ValueError("Estimate must lie between CI limits.")

    log_estimate = np.log(estimate)
    log_lower = np.log(lower)
    log_upper = np.log(upper)

    se_log = (log_upper - log_lower) / (2.0 * 1.96)

    log_samples = rng.normal(log_estimate, se_log, n_samples)

    return np.exp(log_samples), log_samples, se_log


