def hr_to_approx_rr(hr, p0):
    """
    Convert a hazard ratio to an approximate 4-year risk ratio.

    Under constant hazards: p_T = 1 - (1 - p_C)^HR
                           RR = p_T / p_C

    This is an approximation; HR and RR are not identical estimands.
    """
    if not (0 < p0 < 1):
        raise ValueError("p0 must be between 0 and 1.")
    if hr <= 0:
        raise ValueError("HR must be > 0.")

    p_t = 1.0 - (1.0 - p0) ** hr
    return p_t / p0


def or_to_rr(or_value, p0):
    """Convert an odds ratio to a risk ratio using the baseline event rate."""
    if not (0 < p0 < 1):
        raise ValueError("p0 must be between 0 and 1.")
    if or_value <= 0:
        raise ValueError("OR must be > 0.")

    return or_value / (1.0 - p0 + p0 * or_value)


