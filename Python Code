def validate_utility_weights(weights):
    """Validate that all required utility weights are present."""
    required = {
        "avoided_progression",
        "avoided_treatment",
        "egfr_penalty_per_10ml",
        "pill_burden_per_pill",
        "baseline_pills",
        "expected_egfr_drop",
        "egfr_drop_sd",
    }

    missing = required - set(weights)
    if missing:
        raise KeyError(f"Missing utility weights: {sorted(missing)}")

    if weights["egfr_drop_sd"] < 0:
        raise ValueError("egfr_drop_sd must be >= 0.")


def expected_egfr_penalty(egfr_values, utility_weights):
    """
    Calculate E[eGFR penalty | patient] analytically.

    If eGFR decline D ~ Normal(mu, sigma^2), then:

        E[max(0, 60 - (eGFR - D))]
        = a * Phi(a/sigma) + sigma * phi(a/sigma)

    where a = 60 - eGFR + mu.

    This removes Monte Carlo noise from the expected-utility calculation.
    """
    validate_utility_weights(utility_weights)

    egfr_values = np.asarray(egfr_values, dtype=float)

    mu = utility_weights["expected_egfr_drop"]
    sigma = utility_weights["egfr_drop_sd"]
    penalty_weight = utility_weights["egfr_penalty_per_10ml"]

    a = 60.0 - egfr_values + mu

    if sigma == 0:
        expected_excess = np.maximum(0.0, a)
    else:
        z = a / sigma
        phi = np.exp(-0.5 * z**2) / np.sqrt(2.0 * np.pi)
        Phi = 0.5 * (1.0 + erf(z / np.sqrt(2.0)))
        expected_excess = a * Phi + sigma * phi

    return penalty_weight * expected_excess / 10.0


def expected_utility_profiles(baseline_risk, egfr, pill_count, rr_draws, utility_weights):
    """
    Calculate E[Delta U] for multiple patients in a vectorised manner.

    The treatment-effect expectation is computed analytically because
    utility benefit is linear in RRR = 1 - RR.

    Returns:
        expected_utility: one value per patient
        decision: 1 if expected utility > 0, else 0
    """
    validate_utility_weights(utility_weights)

    baseline_risk = np.asarray(baseline_risk, dtype=float)
    egfr = np.asarray(egfr, dtype=float)
    pill_count = np.asarray(pill_count, dtype=float)
    rr_draws = np.asarray(rr_draws, dtype=float)

    if not (len(baseline_risk) == len(egfr) == len(pill_count)):
        raise ValueError("Patient arrays must have equal length.")

    mean_rrr = np.mean(1.0 - rr_draws)

    benefit_weight = (
        utility_weights["avoided_progression"]
        + utility_weights["avoided_treatment"]
    )

    expected_benefit = baseline_risk * mean_rrr * benefit_weight

    baseline_pills = utility_weights["baseline_pills"]
    incremental_pills = np.maximum(0.0, pill_count - baseline_pills)

    pill_penalty = utility_weights["pill_burden_per_pill"] * incremental_pills

    egfr_penalty = expected_egfr_penalty(egfr, utility_weights)

    expected_utility = expected_benefit - egfr_penalty - pill_penalty

    decision = (expected_utility > 0.0).astype(int)

    return expected_utility, decision


