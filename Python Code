def find_decision_threshold(rr_draws, egfr, pill_count, utility_weights, risk_max=0.50, n_grid=501):
    """
    Find the first baseline risk where E[Delta U] crosses zero.

    Because expected utility is linear in baseline risk (conditional on
    the mean RRR), the threshold is deterministic for a given utility
    configuration and treatment-effect distribution.

    Returns:
        threshold: risk at which E[Delta U] = 0, or None if no crossing
        risks: grid of risk values
        utilities: corresponding expected utility values
    """
    risks = np.linspace(0.0, risk_max, n_grid)

    mean_rrr = np.mean(1.0 - rr_draws)
    benefit_weight = (
        utility_weights["avoided_progression"]
        + utility_weights["avoided_treatment"]
    )

    egfr_penalty = expected_egfr_penalty(
        np.asarray([egfr]),
        utility_weights,
    )[0]

    pill_penalty = (
        utility_weights["pill_burden_per_pill"]
        * max(
            0.0,
            pill_count - utility_weights["baseline_pills"],
        )
    )

    utilities = (
        risks * mean_rrr * benefit_weight
        - egfr_penalty
        - pill_penalty
    )

    if utilities[0] >= 0.0:
        return float(risks[0]), risks, utilities

    signs = np.sign(utilities)
    crossings = np.where(signs[:-1] * signs[1:] < 0)[0]

    if len(crossings) == 0:
        return None, risks, utilities

    idx = crossings[0]
    x1, x2 = risks[idx], risks[idx + 1]
    y1, y2 = utilities[idx], utilities[idx + 1]

    threshold = x1 - y1 * (x2 - x1) / (y2 - y1)

    return float(threshold), risks, utilities


def format_threshold(value):
    """Format a threshold value, handling None."""
    if value is None or not np.isfinite(value):
        return "No crossing"
    return f"{value:.1%}"


