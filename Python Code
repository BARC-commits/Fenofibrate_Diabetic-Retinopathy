def sample_posterior_hr(hr, hr_lower, hr_upper, n_samples=100000, seed=42):
    """
    Sample from the posterior distribution of the log-Hazard Ratio.
    Uses a normal approximation on the log scale.
    """
    np.random.seed(seed)
    
    log_hr = np.log(hr)
    log_hr_lower = np.log(hr_lower)
    log_hr_upper = np.log(hr_upper)
    
    se_log_hr = (log_hr_upper - log_hr_lower) / (2 * 1.96)
    
    log_hr_samples = np.random.normal(log_hr, se_log_hr, n_samples)
    hr_samples = np.exp(log_hr_samples)
    
    return hr_samples, log_hr_samples, se_log_hr

def sample_posterior_event_rate(event_rate, n, n_samples=100000, seed=42):
    """
    Sample from the posterior distribution of an event rate.
    Uses a Beta-binomial conjugate model.
    """
    np.random.seed(seed)
    
    k = int(event_rate * n)
    
    alpha = 1
    beta_param = 1
    posterior_alpha = alpha + k
    posterior_beta = beta_param + n - k
    
    rate_samples = np.random.beta(posterior_alpha, posterior_beta, n_samples)
    
    return rate_samples

