def equal_tail_interval(samples, cred=0.95):
    """Compute an equal-tail interval for a set of samples."""
    alpha = 1.0 - cred
    return (
        np.percentile(samples, 100.0 * alpha / 2.0),
        np.percentile(samples, 100.0 * (1.0 - alpha / 2.0)),
    )


def compute_overlap_metrics(samples1, samples2, bins=100):
    """
    Compute descriptive overlap metrics between two empirical distributions.
    """
    lower1, upper1 = equal_tail_interval(samples1)
    lower2, upper2 = equal_tail_interval(samples2)

    overlap_length = max(
        0.0,
        min(upper1, upper2) - max(lower1, lower2),
    )

    width1 = upper1 - lower1
    width2 = upper2 - lower2

    interval_overlap_pct = (
        100.0 * overlap_length / min(width1, width2)
        if min(width1, width2) > 0
        else np.nan
    )

    combined = np.concatenate([samples1, samples2])
    bin_edges = np.linspace(
        np.min(combined),
        np.max(combined),
        bins + 1,
    )

    hist1, _ = np.histogram(samples1, bins=bin_edges, density=False)
    hist2, _ = np.histogram(samples2, bins=bin_edges, density=False)

    hist1 = hist1.astype(float)
    hist2 = hist2.astype(float)

    hist1 /= hist1.sum()
    hist2 /= hist2.sum()

    epsilon = 1e-12
    hist1 = (hist1 + epsilon) / np.sum(hist1 + epsilon)
    hist2 = (hist2 + epsilon) / np.sum(hist2 + epsilon)

    js_distance = jensenshannon(hist1, hist2)
    bhattacharyya_distance = -np.log(np.sum(np.sqrt(hist1 * hist2)))
    wasserstein = wasserstein_distance(samples1, samples2)

    n = min(len(samples1), len(samples2))
    prob_samples1_greater = np.mean(samples1[:n] > samples2[:n])

    return {
        "interval_overlap_pct": interval_overlap_pct,
        "bhattacharyya_distance": bhattacharyya_distance,
        "jensen_shannon_distance": js_distance,
        "wasserstein_distance": wasserstein,
        "prob_samples1_greater": prob_samples1_greater,
        "prob_samples2_greater": 1.0 - prob_samples1_greater,
        "interval1": (lower1, upper1),
        "interval2": (lower2, upper2),
    }


