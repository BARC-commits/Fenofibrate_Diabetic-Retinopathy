def classify_scenario(overlap_percent, concordance_rate):
    """
    Classify the scenario based on the pre-specified typology.
    
    Thresholds (MECE-compliant):
    - High Overlap: >80%  | Low Overlap: ≤80%
    - High Concordance: >90% | Low Concordance: ≤90%
    """
    is_high_overlap = overlap_percent > 80
    is_high_concordance = concordance_rate > 90
    
    if is_high_overlap and is_high_concordance:
        scenario = "A"
        description = "Full Structural & Utility Stability"
        implication = "Universal decision framework; simple point-of-care integration recommended."
    elif not is_high_overlap and not is_high_concordance:
        scenario = "B"
        description = "Contextual Non-Equivalence"
        implication = "Landmark trials cannot be treated as interchangeable; guidelines must be risk-stratified."
    elif not is_high_overlap and is_high_concordance:
        scenario = "C"
        description = "Robust Utility Boundary despite Effect Heterogeneity"
        implication = "Effect size variation does not alter point-of-care decisions; prioritize baseline risk stratification."
    elif is_high_overlap and not is_high_concordance:
        scenario = "D"
        description = "Utility Threshold Hypersensitivity"
        implication = "Effect estimates are statistically compatible, but baseline risk differences shift the prescribing boundary; mandatory individual-level risk calculators."
    else:
        scenario = "ERROR"
        description = "Invalid classification"
        implication = "Check threshold logic"
    
    return scenario, description, implication

